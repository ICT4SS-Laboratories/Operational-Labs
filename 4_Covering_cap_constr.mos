model CapacitatedCovering
uses "mmxprs", "mmsystem"

declarations
  N = 15         ! Demand points
  M = 5          ! Candidate facilities
  
  DEMAND = 1..N
  FACILITIES = 1..M
  
  Dx, Dy: array(DEMAND) of real
  Fx, Fy: array(FACILITIES) of real
  
  d: array(DEMAND) of integer        ! Demand quantity
  C: array(FACILITIES) of integer    ! Capacity
  f: array(FACILITIES) of real       ! Fixed opening cost
  c: array(DEMAND, FACILITIES) of real ! Service cost
  
  x: array(DEMAND, FACILITIES) of mpvar ! Assignment
  y: array(FACILITIES) of mpvar         ! Opening
end-declarations

! Generate arbitrary non-trivial instance
setrandseed(42)

! Generate points and demands (1 to 10)
forall(i in DEMAND) do
  Dx(i) := random
  Dy(i) := random
  d(i) := 1 + round(random * 9)
end-do

! Generate facilities, capacities (30 to 60) and fixed costs
forall(j in FACILITIES) do
  Fx(j) := random
  Fy(j) := random
  C(j) := 30 + round(random * 30)
  f(j) := 50 + random * 50
end-do

! Calculate service costs (proportional to distance)
forall(i in DEMAND, j in FACILITIES) do
  c(i,j) := 10 * sqrt((Dx(i)-Fx(j))^2 + (Dy(i)-Fy(j))^2)
end-do

! Variables
forall(j in FACILITIES) y(j) is_binary
forall(i in DEMAND, j in FACILITIES) x(i,j) is_binary

! Constraints
forall(i in DEMAND) sum(j in FACILITIES) x(i,j) = 1
forall(j in FACILITIES) sum(i in DEMAND) d(i) * x(i,j) <= C(j) * y(j)

! Objective
TotalCost := sum(j in FACILITIES) f(j) * y(j) + sum(i in DEMAND, j in FACILITIES) c(i,j) * x(i,j)
minimize(TotalCost)

if getprobstat = XPRS_OPT then
  writeln("\nCapacitated Covering - Optimal Solution Found")
  writeln("Total Cost: ", strfmt(getobjval, 5, 2))
  forall(j in FACILITIES | getsol(y(j)) > 0.5) do
    writeln("Facility ", j, " opened (Capacity: ", C(j), ")")
    write("  Serving points: ")
    forall(i in DEMAND | getsol(x(i,j)) > 0.5) write(i, " (d=", d(i), ") ")
    writeln("")
  end-do
else
  writeln("Infeasible instance. Check capacity conditions.")
end-if

end-model