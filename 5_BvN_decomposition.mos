model BirkhoffVonNeumann
uses "mmxprs"

!~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~!
! Parameters and decision variables   !
!~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~!

declarations
  N    = 6    ! Matrix dimension (N x N)
  MaxB = 12   ! Maximum entry value
  K    = 57   ! Upper bound
  SEED = 2   ! Random seed

  ROWS = 1..N
  COLS = 1..N
  MATS = 1..K

  B: array(ROWS, COLS) of integer  ! Input matrix

  x: array(MATS)           of mpvar  ! 1 if sub-permutation matrix h is used
  a: array(MATS,ROWS,COLS) of mpvar  ! Entries of sub-permutation matrix h
end-declarations

! Generate a random NxN matrix with entries in {0,...,MaxB}
setrandseed(SEED)
writeln("\nSEED = ", SEED)

forall(i in ROWS, j in COLS) B(i,j) := round(random * MaxB)

writeln("\nInput matrix B:")
forall(i in ROWS) do
  forall(j in COLS) write(B(i,j), "\t")
  writeln("")
end-do

!~~~~~~~~~~~~~!
! Constraints !
!~~~~~~~~~~~~~!

! Binary variables
forall(h in MATS) x(h) is_binary
forall(h in MATS, i in ROWS, j in COLS) a(h,i,j) is_binary

! Sub-permutation: at most one 1 per column and per row in each matrix
forall(h in MATS, j in COLS) sum(i in ROWS) a(h,i,j) <= 1
forall(h in MATS, i in ROWS) sum(j in COLS) a(h,i,j) <= 1

! The sub-permutation matrices must sum entry-wise to B
forall(i in ROWS, j in COLS) sum(h in MATS) a(h,i,j) = B(i,j)

! Linking: a non-zero entry in matrix h forces x(h) = 1
forall(h in MATS, i in ROWS, j in COLS) a(h,i,j) <= x(h)

! Symmetry breaking: use lower-indexed matrices first
forall(h in 1..K-1) x(h) >= x(h+1)

!~~~~~~~~~~~~~~~~~~~~!
! Objective function !
!~~~~~~~~~~~~~~~~~~~~!

minimize(sum(h in MATS) x(h))

!~~~~~~~~~!
! Results !
!~~~~~~~~~!

if getprobstat = XPRS_OPT then
  writeln("\nMinimum number of sub-permutation matrices: ", round(getobjval))
  cnt := 0
  forall(h in MATS | getsol(x(h)) > 0.5) do
    cnt += 1
    writeln("\nSub-permutation matrix A^", cnt, ":")
    forall(i in ROWS) do
      forall(j in COLS) write(round(getsol(a(h,i,j))), " ")
      writeln("")
    end-do
  end-do
else
  writeln("No optimal solution found. Try increasing K.")
end-if

end-model